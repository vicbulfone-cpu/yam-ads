# YAM v4 — environment variables.
# Copy this file to .env.local for your computer, and enter the same names in Vercel
# (Project → Settings → Environment Variables) for the live site.
# Never commit real values. Lines starting with NEXT_PUBLIC_ are visible to visitors' browsers.

# --- Site ---------------------------------------------------------------
# The live address of the website (used for canonical links, the sitemap and structured data).
NEXT_PUBLIC_SITE_URL=https://youraccountantmatch.com.au

# --- Questionnaire ------------------------------------------------------
# Where every "Get Match Now" button and the hero postcode box send visitors. Change it here only.
NEXT_PUBLIC_QUESTIONNAIRE_URL=/questionnaire

# --- Google --------------------------------------------------------------
# Google Analytics 4 measurement ID (kept from the old site).
NEXT_PUBLIC_GA_ID=G-W28MK4GXCT
# Google Ads conversion tracking (fill in when the Google Ads account is ready).
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=

# --- GoHighLevel (GHL) ---------------------------------------------------
# GHL "inbound webhook" address that receives every new lead from the questionnaire.
GHL_INBOUND_WEBHOOK_URL=
# Shared secret that GHL must send (in a header) when it posts the match back to the website.
GHL_WEBHOOK_SECRET=
# true = run the whole lead and match flow on your computer with a sample accountant (no GHL needed).
MOCK_GHL=true

# --- Match storage (Upstash Redis, added through the Vercel Marketplace) ------
# These are filled in automatically in Vercel when you add Upstash Redis to the project.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Lead form protection -------------------------------------------------
# Maximum questionnaire submissions allowed per visitor per minute (stops spam).
LEAD_RATE_LIMIT_PER_MINUTE=5


# --- SEO and tracking (all optional; nothing loads while empty) -----------------
# Google Search Console "HTML tag" verification code (only the content value).
NEXT_PUBLIC_GSC_VERIFICATION=
# Bing Webmaster Tools verification code (the msvalidate.01 content value).
NEXT_PUBLIC_BING_VERIFICATION=
# Google Analytics 4 measurement ID, like G-XXXXXXXXXX.
NEXT_PUBLIC_GA4_ID=
# Google Ads ID, like AW-XXXXXXXXXX (conversion tracking on questionnaire completion is wired in Stage 4).
NEXT_PUBLIC_GADS_ID=
